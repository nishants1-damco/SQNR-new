{
  "name": "@spatial/pipeline",
  "version": "0.0.0",
  "private": true,
  "description": "Room-reconstruction pipeline: model providers, analysis passes, checkpointed runner and persistence. Runs in apps/worker.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "prompts"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@spatial/db": "workspace:*",
    "@spatial/domain": "workspace:*",
    "@spatial/storage": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@spatial/config": "workspace:*",
    "@spatial/eslint-config": "workspace:*",
    "@spatial/tsconfig": "workspace:*",
    "@types/node": "^24.19.0",
    "jpeg-js": "^0.4.4"
  }
}

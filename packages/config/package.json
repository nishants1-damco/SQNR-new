{
  "name": "@spatial/config",
  "version": "0.0.0",
  "private": true,
  "description": "Validated environment configuration for apps/api and apps/worker, plus local-stack defaults.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@spatial/eslint-config": "workspace:*",
    "@spatial/tsconfig": "workspace:*",
    "@types/node": "^24.19.0"
  }
}

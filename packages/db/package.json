{
  "name": "@spatial/db",
  "version": "0.0.0",
  "private": true,
  "description": "PostgreSQL schema (SQL-first migrations), migrator, Drizzle schema and test-database helper.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "migrate": "tsx src/cli/migrate.ts",
    "status": "tsx src/cli/migrate.ts --status"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@spatial/config": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@spatial/eslint-config": "workspace:*",
    "@spatial/tsconfig": "workspace:*",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15"
  }
}

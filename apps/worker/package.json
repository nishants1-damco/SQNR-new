{
  "name": "@spatial/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Spatial Capture background worker: outbox relay and BullMQ jobs (NestJS application context).",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@spatial/config": "workspace:*",
    "@spatial/db": "workspace:*",
    "@spatial/domain": "workspace:*",
    "@spatial/storage": "workspace:*",
    "bullmq": "^6.3.10",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@spatial/eslint-config": "workspace:*",
    "@spatial/tsconfig": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.12",
    "@types/node": "^24.19.0",
    "@types/pg": "^8.23.1",
    "jpeg-js": "^0.4.4",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "typescript": "~5.9.3",
    "unplugin-swc": "^2.0.0"
  }

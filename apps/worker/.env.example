# apps/worker local settings. Everything is optional outside production:
# unset connections fall back to the local Docker stack (pnpm infra:up).
NODE_ENV=development
LOG_LEVEL=debug
# DATABASE_URL=postgres://app_rw:app_rw_dev@127.0.0.1:6432/spatial
# REDIS_QUEUE_URL=redis://127.0.0.1:6379
# QUEUE_PREFIX=spatial
# OUTBOX_POLL_MS=1000
# MEDIA_CONCURRENCY=2
# BLOB_GC_CONCURRENCY=4
# HEALTH_PORT=3100

# ---- Analysis (plan §9.7) ----
# Claude through Anthropic's API, called with the official SDK (native
# Messages API, not an OpenAI-compatible endpoint). Required in production.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_FALLBACK_MODEL=claude-sonnet-5
# ANTHROPIC_REFUSAL_FALLBACKS=true
# Local open-source models (development only). Start with `pnpm infra:llm`
# and `pnpm infra:llm:models`.
# LLM_LOCAL_ENABLED=true
# LLM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
# LLM_LOCAL_MODEL=qwen2.5vl-3b-48k
# ANALYSIS_CLOUD_CONCURRENCY=2
# ANALYSIS_LOCAL_CONCURRENCY=1
# PRIVACY_PURGE_CONCURRENCY=2
# ANALYSIS_ATTEMPTS=3
# ANALYSIS_REVIEW_BUDGET_MS=100000
# Global limits shared by every worker through Redis. Set the three
# per-minute limits to 85% of what Anthropic granted; 0 = not limited here.
# LLM_PERMITS_CLAUDE=16
# LLM_PERMITS_LOCAL=1
# LLM_RPM_LIMIT=0
# LLM_ITPM_LIMIT=0
# LLM_OTPM_LIMIT=0
# Product-catalog embeddings: gemini | ollama | none.
# EMBEDDING_PROVIDER=none
# EMBEDDING_MODEL=
# GEMINI_API_KEY=
# Origins catalog reference photos may be downloaded from (https, comma-separated).
# CATALOG_IMAGE_ORIGINS=

# ---- Load testing (plan §18.1) ----
# A stand-in for Claude with realistic latency and some 429s, through the real
# LLM gate. Refused when DEPLOY_ENV (or NODE_ENV) is production.
# DEPLOY_ENV=development
# LLM_STUB=false
# LLM_STUB_LATENCY_MS=60000
# LLM_STUB_429_RATE=0.02

# ---- Telemetry ----
# Off unless an exporter is set; see apps/api/.env.example. The worker keeps
# every trace (analysis jobs are few and long).
# OTEL_EXPORTER_OTLP_ENDPOINT=
# APPLICATIONINSIGHTS_CONNECTION_STRING=

# Container of catalog reference photos; rows migrated from Supabase store keys in it.
# BLOB_CONTAINER_CATALOG=catalog-images

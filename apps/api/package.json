{
  "name": "@spatial/api",
  "version": "0.0.0",
  "private": true,
  "description": "Spatial Capture HTTP API (NestJS on Fastify).",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed": "node dist/cli/seed.js",
    "keys:generate": "node dist/cli/generate-keys.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-fastify": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@node-rs/argon2": "^2.2.1",
    "@opentelemetry/api": "^1.9.1",
    "@spatial/config": "workspace:*",
    "@spatial/contracts": "workspace:*",
    "@spatial/db": "workspace:*",
    "@spatial/domain": "workspace:*",
    "@spatial/observability": "workspace:*",
    "@spatial/storage": "workspace:*",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.3",
    "fastify": "5.12.5",
    "ioredis": "^5.11.1",
    "jose": "^5.10.0",
    "nestjs-pino": "^5.2.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"

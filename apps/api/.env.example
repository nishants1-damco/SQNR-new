# apps/api local settings. Everything is optional outside production: unset
# connections fall back to the local Docker stack (pnpm infra:up).
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
WEB_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Without a key the API generates a new signing key on every start, which
# signs everyone out on restart. For a stable key: pnpm --filter @spatial/api keys:generate
# JWT_PRIVATE_KEY=
# JWT_KEY_ID=

# DATABASE_URL=postgres://app_rw:app_rw_dev@127.0.0.1:6432/spatial
# REDIS_CACHE_URL=redis://127.0.0.1:6379
# SMTP_URL=smtp://127.0.0.1:1025

# ---- Analysis (plan §9.7) ----
# The worker's queue Redis: analysis progress is published there for the
# event stream. QUEUE_PREFIX must match the worker's.
# REDIS_QUEUE_URL=redis://127.0.0.1:6379
# QUEUE_PREFIX=spatial
# Provider for runs that don't ask for one (claude | ollama). The API stamps
# the model on each queued run; the worker runs exactly that model.
# LLM_DEFAULT_PROVIDER=claude
# ANTHROPIC_MODEL=claude-opus-5-5
# Local models are development-only (D12).
# LLM_LOCAL_ENABLED=true
# LLM_LOCAL_MODEL=qwen2.5vl-3b-48k
# SSE_MAX_STREAMS=2000

# apps/api local settings. Everything is optional outside production: unset
# connections fall back to the local Docker stack (pnpm infra:up).
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
WEB_ORIGINS=http://localhost:5173
APP_BASE_URL=http://localhost:5173

# Without a key the API generates a new signing key on every start, which
# signs everyone out on restart. For a stable key: pnpm --filter @spatial/api keys:generate
# JWT_PRIVATE_KEY=
# JWT_KEY_ID=

# DATABASE_URL=postgres://app_rw:app_rw_dev@127.0.0.1:6432/spatial
# REDIS_CACHE_URL=redis://127.0.0.1:6379
# SMTP_URL=smtp://127.0.0.1:1025

# ---- Analysis (plan §9.7) ----
# The worker's queue Redis: analysis progress is published there for the
# event stream. QUEUE_PREFIX must match the worker's.
# REDIS_QUEUE_URL=redis://127.0.0.1:6379
# QUEUE_PREFIX=spatial
# Provider for runs that don't ask for one (claude | ollama). The API stamps
# the model on each queued run; the worker runs exactly that model.
# LLM_DEFAULT_PROVIDER=claude
# ANTHROPIC_MODEL=claude-opus-5-5
# Local models are development-only (D12).
# LLM_LOCAL_ENABLED=true
# LLM_LOCAL_MODEL=qwen2.5vl-3b-48k
# SSE_MAX_STREAMS=2000

# ---- Scale and hardening (plan Phase 5) ----
# Proxies whose X-Forwarded-For entries are believed: a hop count (Azure: 2),
# or true/false. true is refused in production (clients could pick their IP).
# TRUST_PROXY=false
# Front Door profile id: requests without a matching X-Azure-FDID get 403.
# FRONT_DOOR_ID=
# Read replica; recent writers read the primary for REPLICA_STICKY_SECONDS.
# DATABASE_REPLICA_URL=
# REPLICA_STICKY_SECONDS=10
# Connections per pool, and how long a request waits for one before a 503.
# DATABASE_POOL_MAX=20
# DATABASE_POOL_WAIT_MS=2000
# Quotas live in Redis; postgres keeps the original consume_rate_limit().
# QUOTA_BACKEND=redis
# Request ceilings: per signed-in user, and per IP for anonymous requests.
# THROTTLE_USER_PER_MINUTE=300
# THROTTLE_IP_PER_MINUTE=60
# Daily AI spend caps in USD (0 = no global cap), the cost assumed per run,
# and how many queued analyses the API accepts before answering 503.
# AI_DAILY_BUDGET_USD_PER_USER=25
# AI_DAILY_BUDGET_USD_GLOBAL=0
# ANALYSIS_COST_ESTIMATE_USD=5.2
# ANALYSIS_MAX_QUEUED=500

# ---- Telemetry ----
# Off unless an exporter is set. Locally: pnpm infra:otel, then
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318 (Grafana on :3001).
# In Azure, APPLICATIONINSIGHTS_CONNECTION_STRING sends metrics there.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
# APPLICATIONINSIGHTS_CONNECTION_STRING=

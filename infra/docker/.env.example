# Copy to infra/docker/.env to change host ports. Docker Compose reads it
# automatically; every value has a default, so the file is optional.
POSTGRES_PORT=5432
PGBOUNCER_PORT=6432
REDIS_PORT=6379
AZURITE_BLOB_PORT=10000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
OLLAMA_PORT=11434
GRAFANA_PORT=3001
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
